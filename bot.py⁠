        await update.message.reply_text("لطفاً یک لینک معتبر ارسال کنید.")
        return

    status_msg = await update.message.reply_text("در حال پردازش و دانلود فایل... ⏳")
    work_dir = tempfile.mkdtemp(prefix="dl_")

    try:
        filename = await asyncio.to_thread(download_media, url, work_dir)

        if not os.path.exists(filename):
            await status_msg.edit_text(
                "فایل دانلود نشد؛ احتمالاً حجم آن بیشتر از ۵۰ مگابایت است."
            )
            return

        if os.path.getsize(filename) > MAX_FILE_SIZE:
            await status_msg.edit_text(
                "حجم فایل بیشتر از ۵۰ مگابایت است و تلگرام اجازه ارسال آن را نمی‌دهد."
