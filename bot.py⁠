import os
import logging
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import (
    ApplicationBuilder,
    CommandHandler,
    MessageHandler,
    ContextTypes,
    filters,
)
from yt_dlp import YoutubeDL

# ۱. تنظیمات اولیه و لاگینگ
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    level=logging.INFO
)

# ۲. اطلاعات توکن و کانال
TELEGRAM_BOT_TOKEN = "8997758350:AAF-GKbBv3sPj6pC9XU4v" # توکن ربات شما
CHANNEL_ID = "@persiandemure"                           # آیدی کانال شما
CHANNEL_LINK = "https://t.me/persiandemure"             # لینک کانال شما

async def check_membership(user_id: int, context: ContextTypes.DEFAULT_TYPE) -> bool:
    """بررسی عضویت کاربر در کانال"""
    try:
        member = await context.bot.get_chat_member(chat_id=CHANNEL_ID, user_id=user_id)
        if member.status in ['member', 'administrator', 'creator']:
            return True
        return False
    except Exception as e:
        logging.error(f"Error checking membership: {e}")
        return True  # در صورت بروز خطا در چک کانال، مانع کاربر نمی‌شود

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """دستور /start"""
    user_id = update.effective_user.id
    is_member = await check_membership(user_id, context)

    if not is_member:
        keyboard = [
            [InlineKeyboardButton("عضویت در کانال", url=CHANNEL_LINK)],
            [InlineKeyboardButton("بررسی عضویت 🔄", callback_data="check_join")]
        ]
        reply_markup = InlineKeyboardMarkup(keyboard)
        await update.message.reply_text(
            "لطفاً برای استفاده از ربات ابتدا در کانال ما عضو شوید:",
            reply_markup=reply_markup
        )
        return

    await update.message.reply_text(
        "سلام! به ربات دانلودر خوش آمدید 🌹\n"
        "لطفاً لینک ویدیو یا پست مورد نظر را ارسال کنید."
    )

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """پردازش لینک‌های ارسالی"""
    user_id = update.effective_user.id
    is_member = await check_membership(user_id, context)

    if not is_member:
        keyboard = [
            [InlineKeyboardButton("عضویت در کانال", url=CHANNEL_LINK)]
        ]
        await update.message.reply_text(
            "برای استفاده از امکانات ربات باید در کانال عضو باشید.",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )
        return

    url = update.message.text.strip()
    if not url.startswith(("http://", "https://")):
        await update.message.reply_text("لطفاً یک لینک معتبر ارسال کنید.")
        return

    status_msg = await update.message.reply_text("در حال پردازش و دانلود فایل... ⏳")

    ydl_opts = {
        'format': 'best',
        'outtmpl': 'downloaded_media.%(ext)s',
        'max_filesize': 50 * 1024 * 1024,  # محدودیت ۵۰ مگابایت تلگرام
        'quiet': True,
    }

    try:
        with YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=True)
            filename = ydl.prepare_filename(info)

        await status_msg.edit_text("در حال ارسال فایل به تلگرام... 📤")
        
        with open(filename, 'rb') as media_file:
            await update.message.reply_document(document=media_file)
            
        await status_msg.delete()

        # پاک‌‌سازی فایل از روی سرور پس از ارسال
        if os.path.exists(filename):
            os.remove(filename)

    except Exception as e:
        logging.error(f"Download Error: {e}")
        await status_msg.edit_text("خطا در دانلود فایل. ممکن است لینک نامعتبر باشد یا حجم فایل بیش از حد مجاز باشد.")

def main():
    """شروع به کار ربات"""
    app = ApplicationBuilder().token(TELEGRAM_BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))

    print("Bot is running...")
    app.run_polling()

if __name__ == "__main__":
    main()
